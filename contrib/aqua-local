#!/bin/bash
# Aqua local service manager
# Usage: ./contrib/aqua-local {start|stop|restart|status|logs}

set -e
DIR="$(cd "$(dirname "$0")/.." && pwd)"
PIDFILE="$DIR/aqua.pid"
LOGFILE="$DIR/aqua.log"

case "${1:-help}" in
  start)
    if [ -f "$PIDFILE" ] && kill -0 $(cat "$PIDFILE") 2>/dev/null; then
      echo "Aqua is already running (pid $(cat $PIDFILE))"
      exit 0
    fi
    cd "$DIR"
    echo "Starting Aqua..."
    nohup uvicorn main:app --host 0.0.0.0 --port 8000 >> "$LOGFILE" 2>&1 &
    echo $! > "$PIDFILE"
    echo "Aqua started (pid $(cat $PIDFILE))"
    echo "Web UI: http://localhost:8000/ui/"
    echo "API:    http://localhost:8000/"
    ;;
  stop)
    if [ ! -f "$PIDFILE" ]; then
      echo "Aqua is not running"
      exit 0
    fi
    PID=$(cat "$PIDFILE")
    echo "Stopping Aqua (pid $PID)..."
    kill "$PID" 2>/dev/null || true
    rm -f "$PIDFILE"
    echo "Stopped"
    ;;
  restart)
    $0 stop
    sleep 1
    $0 start
    ;;
  status)
    if [ -f "$PIDFILE" ] && kill -0 $(cat "$PIDFILE") 2>/dev/null; then
      echo "Aqua is running (pid $(cat $PIDFILE))"
      echo "Web UI: http://localhost:8000/ui/"
    else
      echo "Aqua is not running"
    fi
    ;;
  logs)
    tail -f "$LOGFILE"
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|status|logs}"
    exit 1
    ;;
esac

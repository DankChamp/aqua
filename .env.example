# Aqua - Environment Configuration
# Copy this to .env and fill in what you have.

# --- API Keys (leave blank to disable a provider) ---
GROQ_API_KEY=
NVIDIA_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- Local Providers ---
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_BASE_URL=
LOCAL_API_KEY=
LOCAL_DEFAULT_MODEL=

# --- Default Models ---
OLLAMA_DEFAULT_MODEL=llama3.2:3b
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile
NVIDIA_DEFAULT_MODEL=meta/llama-3.1-8b-instruct
OPENAI_DEFAULT_MODEL=gpt-4o-mini
ANTHROPIC_DEFAULT_MODEL=claude-3-haiku-20240307
GOOGLE_DEFAULT_MODEL=gemini-2.0-flash-exp

# --- Routing ---
PREFER_LOCAL_WHEN_AVAILABLE=true

# --- Web ---
AQUA_WEB_PASSWORD=

# --- Emma (superior AI) ---
# Set this to let Aqua push research summaries up to Emma.
EMMA_API_URL=http://127.0.0.1:8000
EMMA_API_KEY=
